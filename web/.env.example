# ============================================================
# Curio · 环境变量模板
# 拷贝此文件为 .env.local 并填入真实值
# ============================================================

# --- Supabase ---
# 在 Supabase 项目设置 → API 找到
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 仅服务端用，不要前缀 NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- DeepSeek (text + VL vision + ASR voice) ---
# 在 platform.deepseek.com 申请
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型 ID 见 SPEC.md § 8.1（v4-flash / v4-pro / vl / asr）

# --- 阿里 DashScope (embedding · 主用) ---
# 在阿里云百炼控制台 → API-Key 申请
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# 默认用 text-embedding-v3（1024 维）

# 备选视觉模型：Qwen3-VL-Plus（同一个 DASHSCOPE_API_KEY）
# 如果想从豆包切回 Qwen-VL，改 process.ts 的 import 即可，不用动这两个
DASHSCOPE_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VL_MODEL=qwen3-vl-plus

# --- 火山引擎方舟 ARK (视觉 · 主用) ---
# 豆包 Seed-2.0-Pro 视觉模型
# 在 https://console.volcengine.com/ark 拿 API Key
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VL_MODEL=doubao-seed-2-0-pro-260215

# --- 站点 ---
# 本地开发 http://localhost:3001；部署到 Vercel 后改为 https://curio-yuri.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- 种子用户 fallback ---
# 运行 `pnpm seed:user` 后会打印出 UID，把它填到这里
# 开发期（NODE_ENV !== production）自动跳过登录用这个用户
DEV_SEED_USER_ID=

# 只在 Vercel production 环境设这个 = true，让生产环境也用种子用户身份
# V0 自用阶段开启；V1 商业化前关闭强制走 magic link
ALLOW_SEED_USER_IN_PROD=

# --- iOS Shortcuts / 外部捕获 token ---
# 随便给一个长字符串（建议 32+ 字符），iPhone 快捷指令请求 /api/capture/shortcut
# 时在 Authorization: Bearer 头里带上这个值
# 生成命令（在终端）：openssl rand -hex 24
SHORTCUTS_TOKEN=
